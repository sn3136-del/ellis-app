# Ellis Portal Automation — environment template (NO SECRETS committed).
# Copy to .env and fill in only what you have. Anything left blank disables ONLY
# that integration; the workflow still runs end-to-end via applicant-controlled
# fallbacks.

# --- Secrets vault -----------------------------------------------------------
# Node fallback passphrase (dev/test only). Production uses Electron safeStorage
# or AWS Secrets Manager; do NOT rely on this in production.
ELLIS_VAULT_PASSPHRASE=

# --- Stripe Issuing (automated fee payment; optional) ------------------------
# Absent  -> applicant-controlled embassy payment window is used.
STRIPE_SECRET_KEY=
# Must be exactly "true" AND the portal adapter must permit automated payment.
ELLIS_ISSUING_APPROVED=

# --- Browserbase (isolated remote browser + Live View; optional) -------------
# Absent  -> local_handoff instruction panel is used for human steps.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Docusign (embedded authorization; optional) -----------------------------
# Absent  -> in-app typed/drawn authorization (hashed, auditable) is used.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=

# --- AWS (encrypted storage + secrets, production) ---------------------------
AWS_REGION=
AWS_SECRETS_PREFIX=
S3_BUCKET=
KMS_KEY_ID=

# --- Existing Ellis AI / email (already configured in-app) -------------------
# Kimi / Anthropic / SMTP are configured through Ellis Settings, not here.
