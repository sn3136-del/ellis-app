{
  "name": "ellis",
  "version": "1.0.0",
  "description": "Ellis - AI workspace for immigration operations",
  "main": "./out/main/index.js",
  "author": "Ellis",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:dir": "electron-vite build && electron-builder --mac --dir",
    "scan:release": "./scripts/scan-release-secrets.sh",
    "test": "node --test --test-concurrency=1 tests/build_security.test.mjs tests/visa/visa_ui_logic.test.mjs tests/visa/i18n.test.mjs tests/portal/framework.test.mjs tests/portal/e2e.test.mjs",
    "test:portal": "node --test --test-concurrency=1 tests/portal/framework.test.mjs tests/portal/e2e.test.mjs",
    "test:security": "node --test tests/build_security.test.mjs",
    "test:visa": "node --test tests/visa/visa_ui_logic.test.mjs",
    "test:visa:api": "node --test tests/visa/frontend_backend.test.mjs"
  },
  "build": {
    "appId": "com.ellis.app",
    "productName": "Ellis",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!**/*.key",
      "!**/*.pem",
      "!**/*.p12",
      "!**/*.pfx",
      "!**/id_rsa*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.env",
      "!**/application_default_credentials.json",
      "!**/service-account*.json",
      "!**/kimi.key",
      "!**/private_fixtures/**",
      "!**/*.passport"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "nodemailer": "^9.0.3",
    "openai": "^4.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
