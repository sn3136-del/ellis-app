{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ellis://schemas/global_visa_route.schema.json",
  "title": "Global tourist-visa route record (snapshot 2026-07-23)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_date", "record_id", "version", "route_key",
    "passport_nationality", "passport_issuing_country", "travel_document_type",
    "lawful_country_of_residence", "destination_country", "visa_category",
    "travel_purpose", "research_status", "human_review_status", "fee_status",
    "portal_verification_status", "adapter_status", "conflict_status", "content_hash"
  ],
  "properties": {
    "snapshot_date": { "type": "string", "format": "date", "const": "2026-07-23" },
    "record_id": { "type": "string", "minLength": 8 },
    "version": { "type": "integer", "minimum": 1 },
    "route_key": { "type": "string", "minLength": 16 },
    "passport_nationality": { "type": "string", "minLength": 3, "maxLength": 3 },
    "passport_issuing_country": { "type": "string", "minLength": 2, "maxLength": 3 },
    "travel_document_type": { "type": "string" },
    "lawful_country_of_residence": { "type": "string", "minLength": 2, "maxLength": 3 },
    "lawful_residence_status": { "type": ["string", "null"] },
    "destination_country": { "type": "string", "minLength": 2, "maxLength": 3 },
    "visa_category": { "type": "string" },
    "visa_subtype": { "type": ["string", "null"] },
    "travel_purpose": { "type": "string", "const": "tourism" },
    "applicable_arrival_start": { "type": ["string", "null"], "format": "date" },
    "applicable_arrival_end": { "type": ["string", "null"], "format": "date" },
    "maximum_stay": { "type": ["string", "null"] },
    "permitted_entries": { "type": ["string", "null"] },
    "transit_conditions": { "type": ["string", "null"] },
    "visa_required": { "type": ["boolean", "null"] },
    "visa_free": { "type": ["boolean", "null"] },
    "visa_on_arrival": { "type": ["boolean", "null"] },
    "electronic_authorization_required": { "type": ["boolean", "null"] },
    "evisa_available": { "type": ["boolean", "null"] },
    "disposition": { "type": "string", "enum": ["VISA_FREE", "ETA_REQUIRED", "EVISA_REQUIRED", "VISA_ON_ARRIVAL", "EMBASSY_VISA_REQUIRED", "AUTHORIZED_VISA_CENTER_REQUIRED", "TRANSIT_AUTHORIZATION_REQUIRED", "NOT_APPLICABLE", "RESEARCH_INCOMPLETE", "CONFLICTED", "HUMAN_REVIEW_REQUIRED"] },
    "exemption_conditions": { "type": ["array", "null"], "items": { "type": "string" } },
    "required_documents": { "type": ["array", "null"], "items": { "type": "string" } },
    "conditional_documents": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
    "financial_evidence_requirements": { "type": ["string", "null"] },
    "accommodation_evidence": { "type": ["string", "null"] },
    "itinerary_evidence": { "type": ["string", "null"] },
    "insurance_requirements": { "type": ["string", "null"] },
    "invitation_requirements": { "type": ["string", "null"] },
    "passport_validity_rule": { "type": ["object", "null"], "additionalProperties": true },
    "blank_page_rule": { "type": ["string", "null"] },
    "passport_condition_rule": { "type": ["string", "null"] },
    "biometrics_required": { "type": ["boolean", "null"] },
    "interview_required": { "type": ["boolean", "null"] },
    "personal_appearance_required": { "type": ["boolean", "null"] },
    "appointment_required": { "type": ["boolean", "null"] },
    "application_channel": { "type": ["string", "null"], "enum": ["online_portal", "embassy", "consulate", "visa_center", "on_arrival", "not_required", "unknown", null] },
    "competent_embassy_or_consulate": { "type": ["string", "null"] },
    "consular_jurisdiction": { "type": ["string", "null"] },
    "official_application_portal": { "type": ["string", "null"], "format": "uri" },
    "authorized_visa_center": { "type": ["string", "null"] },
    "government_fee": { "type": ["object", "null"], "properties": { "amount": { "type": ["number", "null"] }, "currency": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] } }, "additionalProperties": false },
    "service_fee": { "type": ["object", "null"], "additionalProperties": true },
    "appointment_fee": { "type": ["object", "null"], "additionalProperties": true },
    "biometrics_fee": { "type": ["object", "null"], "additionalProperties": true },
    "courier_fee": { "type": ["object", "null"], "additionalProperties": true },
    "optional_fees": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
    "currency": { "type": ["string", "null"], "minLength": 3, "maxLength": 3 },
    "refundability": { "type": ["string", "null"] },
    "accepted_payment_methods": { "type": ["array", "null"], "items": { "type": "string" } },
    "processing_time_guidance": { "type": ["string", "null"] },
    "third_party_preparation_allowed": { "type": ["boolean", "null"] },
    "third_party_submission_allowed": { "type": ["boolean", "null"] },
    "representative_conditions": { "type": ["string", "null"] },
    "applicant_declaration_required": { "type": ["boolean", "null"] },
    "official_source_urls": { "type": ["array", "null"], "items": { "type": "string", "format": "uri" } },
    "official_verification_urls": { "type": ["array", "null"], "items": { "type": "string", "format": "uri" } },
    "source_authorities": { "type": ["array", "null"], "items": { "type": "string" } },
    "source_excerpts": { "type": ["array", "null"], "items": { "type": "object", "properties": { "url": { "type": "string" }, "excerpt": { "type": "string", "maxLength": 2000 }, "language": { "type": ["string", "null"] } }, "additionalProperties": true } },
    "source_hashes": { "type": ["array", "null"], "items": { "type": "string" } },
    "retrieved_at": { "type": ["string", "null"] },
    "effective_from": { "type": ["string", "null"] },
    "effective_until": { "type": ["string", "null"] },
    "review_after": { "type": ["string", "null"] },
    "human_review_status": { "type": "string", "enum": ["not_reviewed", "queued", "in_review", "human_verified", "rejected"] },
    "research_status": { "type": "string", "enum": ["not_researched", "in_progress", "verified", "research_incomplete", "conflicted", "human_review_required"] },
    "fee_status": { "type": "string", "enum": ["unknown", "verified", "stale", "conflicted", "not_applicable"] },
    "portal_verification_status": { "type": "string", "enum": ["unknown", "verified", "conflicted", "not_applicable", "unavailable"] },
    "adapter_status": { "type": "string", "enum": ["none", "development_queued", "in_development", "mock_tested", "staging_tested", "production_approved", "paused", "killed"] },
    "conflict_status": { "type": "string", "enum": ["none", "open", "resolved"] },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "notes": { "type": ["string", "null"] }
  }
}
