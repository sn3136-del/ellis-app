[Unit]
Description=Ellis six-hour canonical policy freshness sweep
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ellis/backend
EnvironmentFile=/opt/ellis/backend/.env
Environment=ELLIS_KIMI_CONCURRENCY=4
ExecStart=/opt/ellis/backend/.venv/bin/python /opt/ellis/backend/scripts/freshness_sweep.py
TimeoutStartSec=18300
TimeoutStopSec=90
KillSignal=SIGTERM
Nice=10
