# Ellis visa backend — environment template (NO SECRETS committed).
# Copy to .env. Anything left blank disables ONLY that integration; the service
# runs end-to-end on local fallbacks (SQLite, DB workflow runner, local OCR/Kimi
# doubles, applicant payment window, in-app authorization).

# --- Core ---
ELLIS_ENV=development
DATABASE_URL=sqlite:///./ellis.db      # set a Postgres/Neon DSN in production

# --- Auth ---
ELLIS_DEV_TOKEN=
# Admin role token (dev only; production uses a Clerk admin claim). Adapter
# approval/activation/kill/rollback require this token.
ELLIS_ADMIN_TOKEN=dev-token              # dev bearer token; production uses Clerk
CLERK_SECRET_KEY=                      # activation: enables Clerk JWT verification
ELLIS_ACTION_SECRET=change-me          # signs short-lived step-up action tokens

# --- Secrets vault ---
ELLIS_VAULT_PASSPHRASE=change-me       # local key; production uses AWS Secrets Manager
AWS_SECRETS_PREFIX=                     # activation: AWS Secrets Manager backend

# --- Kimi K3 (agentic reasoning) ---
MOONSHOT_API_KEY=                       # activation: live Kimi K3
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_ENABLED=true
KIMI_MAX_AGENT_STEPS=30
KIMI_TIMEOUT_SECONDS=120

# --- OCR (Google Document AI) ---
GOOGLE_CLOUD_PROJECT=                   # activation: live Document AI
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_OCR_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_FORM_PROCESSOR_ID=
DOCUMENT_AI_ENABLED=true

# --- Browserbase (isolated browser + Live View) ---
BROWSERBASE_API_KEY=                    # absent → local_handoff panels
BROWSERBASE_PROJECT_ID=

# --- Stripe Issuing (automated fee payment) ---
STRIPE_SECRET_KEY=                      # absent → applicant payment window
STRIPE_WEBHOOK_SECRET=
ELLIS_ISSUING_APPROVED=false            # must be true AND key set to auto-pay

# --- DocuSign ---
DOCUSIGN_INTEGRATION_KEY=               # absent → in-app authorization
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_HMAC_SECRET=

# --- Storage (S3 + KMS) ---
S3_BUCKET=                              # absent → local encrypted storage refs
KMS_KEY_ID=

# --- Temporal ---
TEMPORAL_HOST=                          # absent → DB-persisted workflow runner
