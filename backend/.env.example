# Ellis visa backend — environment template (NO SECRETS committed).
# Copy to .env. Anything left blank disables ONLY that integration; the service
# runs end-to-end on local fallbacks (SQLite, DB workflow runner, local OCR/Kimi
# doubles, applicant payment window, in-app authorization).

# --- Core ---
ELLIS_ENV=development
DATABASE_URL=sqlite:///./ellis.db      # set a Postgres/Neon DSN in production

# --- Runtime mode (brief section 3 — absolute real-only execution boundary) ---
# One of: test | local_mock_demo | tripcom_evaluation | staging | production.
# MockPortal is permitted ONLY in test/local_mock_demo (permanent SIMULATED
# banner). tripcom_evaluation/staging/production NEVER bind MockPortal: a route
# without an individually approved live adapter stops with UNSUPPORTED /
# PORTAL_UNAVAILABLE instead. Unset → derived from ELLIS_ENV
# (development→local_mock_demo, test→test, staging→staging, else production).
# An INVALID value fails closed to production.
ELLIS_RUNTIME_MODE=local_mock_demo

# --- Visa rules snapshot (frozen; manual reverification only) ---
VISA_RULES_SNAPSHOT_DATE=2026-07-23
VISA_RULES_SNAPSHOT_LABEL="Global tourist-visa requirements snapshot as of July 23, 2026"
VISA_RULES_UPDATE_MODE=manual
AUTOMATIC_RULE_REFRESH_ENABLED=false

# --- Auth ---
ELLIS_DEV_TOKEN=
# Admin role token (dev only; production uses a Clerk admin claim). Adapter
# approval/activation/kill/rollback require this token.
ELLIS_ADMIN_TOKEN=dev-token              # dev bearer token; production uses Clerk
CLERK_SECRET_KEY=                      # activation: enables Clerk JWT verification
ELLIS_ACTION_SECRET=change-me          # signs short-lived step-up action tokens

# --- Secrets vault ---
ELLIS_VAULT_PASSPHRASE=change-me       # local key; production uses AWS Secrets Manager
AWS_SECRETS_PREFIX=                     # activation: AWS Secrets Manager backend

# --- Kimi K3 (agentic reasoning) ---
MOONSHOT_API_KEY=                       # activation: live Kimi K3
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_ENABLED=true
KIMI_MAX_AGENT_STEPS=30
KIMI_TIMEOUT_SECONDS=120

# --- OCR (Google Document AI) ---
GOOGLE_CLOUD_PROJECT=                   # activation: live Document AI
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_OCR_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_FORM_PROCESSOR_ID=
DOCUMENT_AI_ENABLED=true

# --- Browserbase (isolated browser + Live View) ---
BROWSERBASE_API_KEY=                    # absent → local_handoff panels
BROWSERBASE_PROJECT_ID=

# --- Stripe Issuing (automated fee payment) ---
STRIPE_SECRET_KEY=                      # absent → applicant payment window
STRIPE_WEBHOOK_SECRET=
ELLIS_ISSUING_APPROVED=false            # must be true AND key set to auto-pay

# --- DocuSign ---
DOCUSIGN_INTEGRATION_KEY=               # absent → in-app authorization
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_HMAC_SECRET=

# --- Storage (S3 + KMS) ---
S3_BUCKET=                              # absent → local encrypted storage refs
KMS_KEY_ID=

# --- Temporal ---
TEMPORAL_HOST=                          # absent → DB-persisted workflow runner

# --- Transactional email (Phase 7/8) ---
# The first-run setup wizard (or these env vars) configure email. A sender
# address ALONE is not sufficient — SMTP or API credentials are required. In
# staging/production email credentials belong in Secret Manager, not here.
# EMAIL_PROVIDER=smtp                    # smtp | api | local (dev recorder)
# EMAIL_SENDER=noreply@your-tenant.example
# EMAIL_REPLY_TO=
# SMTP_HOST=                             # required for provider=smtp
# SMTP_PORT=587
# SMTP_USERNAME=
# (SMTP password / API key are entered in the setup wizard → backend vault only)

# --- Production preflight (Phase 7) ---
# When ELLIS_ENV=production|staging, /readyz refuses to be ready while any of
# ELLIS_DEV_TOKEN / ELLIS_ADMIN_TOKEN / ELLIS_VAULT_PASSPHRASE / ELLIS_ACTION_SECRET
# is still a default, or CLERK_SECRET_KEY is unset. Set real values before deploy.
